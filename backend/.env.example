# Backend Environment Configuration Template
# Copy this file to .env (git-ignored) and fill in the actual values.
# NEVER commit .env or any file containing real secret values.
#
# ─────────────────────────────────────────────────────────────
# CORS — Required in production
# ─────────────────────────────────────────────────────────────
# Comma-separated list of trusted frontend origins.
# In production, set this to your deployed frontend URL(s):
#   ALLOWED_ORIGINS=https://civic-frontend-<hash>.<region>.run.app
# In local development:
#   ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Gemini / AI Configuration
# ─────────────────────────────────────────────────────────────
# Model identifier (e.g. gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Provider mode: "developer_api" (API key) or "vertex_ai" (ADC)
GEMINI_PROVIDER_MODE=developer_api

# Required when GEMINI_PROVIDER_MODE=developer_api
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-api-key-here>

# Required when GEMINI_PROVIDER_MODE=vertex_ai
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# ─────────────────────────────────────────────────────────────
# Live Demo Feature Flag
# ─────────────────────────────────────────────────────────────
# Controls whether POST /api/demo/scenarios/live/water-convergence
# makes a real Gemini API call. Set to "true" ONLY for the live demo.
# Default: false (safe for all other environments)
DEMO_LIVE_GEMINI_ENABLED=false

# ─────────────────────────────────────────────────────────────
# Runtime / Application
# ─────────────────────────────────────────────────────────────
# Log verbosity: debug, info, warning, error
LOG_LEVEL=info

# Port (uvicorn binds to 0.0.0.0:PORT in production; Cloud Run expects 8080)
PORT=8080

# ─────────────────────────────────────────────────────────────
# Security and Abuse Prevention (Phase 10B-2B)
# ─────────────────────────────────────────────────────────────
# Rate Limits (In-process limits for the current instance only)
RATE_LIMIT_COPILOT=5
RATE_LIMIT_WINDOW_COPILOT=60

RATE_LIMIT_DEMO=2
RATE_LIMIT_WINDOW_DEMO=60

# Max allowed incoming request body size in bytes (default ~100KB)
REQUEST_SIZE_LIMIT_BYTES=102400

# Require HTTPS (emits Strict-Transport-Security header)
REQUIRE_HTTPS=false
