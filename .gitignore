# Raw data and large binary files should remain local-only
data/raw/**/*.zip
data/raw/**/*.xls
data/raw/**/*.csv
data/raw/lgd/extracted/*
data/raw/jjm/*

# Local development artifacts — derived JSONL persistence (DO NOT COMMIT)
# These files are generated by the pipeline and test suites.
# They are large (100+ MB) and must NOT be committed to version control.
data/local_development/
data/local_development/*.jsonl

# Node.js
node_modules/
dist/
build/
.next/

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/

# Environment Variables — never commit actual secret values
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS Files
.DS_Store
Thumbs.db

# Defensive ignore for accidental backend working-directory state
backend/data/local_development/

data/raw/geospatial/vb_soi_ap.GeoJSON
